{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:app:default",
    "core:webview:default",
    "core:window:default",
    "core:image:default",
    "core:resources:default",
    "core:webview:allow-set-webview-background-color",
    "core:event:default",
    "opener:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-appdata-recursive",
    "fs:scope-home-recursive",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load"
  ]
}
