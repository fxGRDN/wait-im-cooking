  "query": "\n            SELECT\n                i.id as \"id!\",\n                i.name,\n                i.default_unit,\n                ii.id         AS inv_id,\n                ii.quantity   AS inv_quantity,\n                ii.unit       AS inv_unit,\n                ii.expires_at AS inv_expires_at\n            FROM ingredients i\n            LEFT JOIN ingredient_inventory ii ON ii.ingredient_id = i.id\n            WHERE i.id = ?\n            ",
