  "db_name": "SQLite",
  "query": "\n            SELECT\n                i.id as \"id!\",\n                i.name,\n                i.default_unit,\n                i.restock_threshold,\n                ii.id         AS inv_id,\n                ii.quantity   AS inv_quantity,\n                ii.unit       AS inv_unit,\n                ii.expires_at AS inv_expires_at\n            FROM ingredients i\n            INNER JOIN ingredient_inventory ii ON ii.ingredient_id = i.id\n            ORDER BY i.name ASC\n            ",
